# Story 1.2 — Secrets de la stack LOCALE uniquement.
#   cp infra/.env.example infra/.env   puis REMPLACEZ CHAQUE VALEUR.
# infra/.env est gitignoré ; en staging/prod les secrets sont injectés à
# l'exécution (solution tranchée par le spike AR-P4, Story 11.2).
#
# ⚠ Les valeurs « remplacez-moi » sont des SENTINELLES : le backend REFUSE de
#   démarrer tant qu'elles sont en place (un cp sans édition ne suffit pas).
# ⚠ Générer les valeurs avec :  openssl rand -base64 48
#   Charset base64 UNIQUEMENT (A-Za-z0-9+/=) : les caractères $ " \ ` sont
#   altérés par l'interpolation compose et/ou le shell de minio-init.
# ⚠ Volumes déjà initialisés : Postgres/pgAdmin/MinIO n'appliquent ces valeurs
#   qu'à la PREMIÈRE initialisation du volume. Si la stack a déjà tourné :
#     docker compose -f infra/docker-compose.yml down -v   (supprime les données locales)
#   sinon l'ancien mot de passe reste actif et le backend échouera en auth.
# ⚠ Docker Compose v2 requis (le .env est résolu depuis infra/ ; v1 le
#   chercherait à la racine).

POSTGRES_PASSWORD=remplacez-moi
PGADMIN_DEFAULT_PASSWORD=remplacez-moi
RABBITMQ_DEFAULT_USER=escrow
RABBITMQ_DEFAULT_PASS=remplacez-moi
MINIO_ROOT_USER=escrow-storage
MINIO_ROOT_PASSWORD=remplacez-moi
# >= 32 octets (HS256) — vérifié au démarrage du backend
ESCROW_JWT_SECRET=remplacez-moi

# --- Chiffrement au repos (Story 1.7, NFR-P6/AD-29) ---
# Protège les secrets HMAC en base et les binaires de preuves dans MinIO contre
# un pg_dump, une copie de volume ou une sauvegarde. Sans ces clés, RIEN n'est
# déchiffrable : les sauvegarder hors de la machine, au même titre qu'un backup.
#
# ESCROW_CRYPTO_KEYS : « id:cléBase64 » séparés par des virgules. Chaque clé fait
#   EXACTEMENT 32 octets décodés :  openssl rand -base64 32
#   (32 octets -> 44 caractères base64 finissant par '='). L'id est libre en
#   [A-Za-z0-9_-] ; « v1 », « v2 »… se lisent bien dans les enveloppes.
#   ex. ESCROW_CRYPTO_KEYS=v1:<les 44 caracteres rendus par openssl rand -base64 32>
#   Charset base64 UNIQUEMENT ici aussi ($ " \ ` sont altérés par compose).
#   Aucune clé d'exemple n'est fournie : une clé versionnée serait une clé publique.
# ESCROW_CRYPTO_ACTIVE_KEY_ID : id de la clé qui CHIFFRE. Vide tant qu'il n'y a
#   qu'une clé (elle est déduite) ; à renseigner pendant une rotation, où le
#   trousseau porte l'ancienne ET la nouvelle. Procédure complète :
#   Docs/runbook-rotation-cles-chiffrement.md
ESCROW_CRYPTO_KEYS=remplacez-moi
ESCROW_CRYPTO_ACTIVE_KEY_ID=

# --- Analyse anti-malware à l'ingestion (Story 1.8, NFR-P7) ---
# Tout fichier déposé (preuve, litige, dépôt partenaire) est analysé par le service
# `clamav` de la stack AVANT d'être stocké. Il n'y a AUCUN moyen de désactiver le
# scan : si clamav n'est pas démarré (ou pas encore « healthy »), tout dépôt échoue
# en 502 SCAN_UNAVAILABLE. C'est délibéré — cf. Docs/runbook-antivirus-ingestion.md.
#
# Ni l'hôte ni le port ne sont des secrets : ils sont écrits en clair dans le
# compose (`clamav:3310`) et n'ont pas de variable ici. Seuls les timeouts sont
# ajustables, et seulement si nécessaire :
# ⚠ Premier démarrage plus long : clamd charge ~1,3 Go de signatures avant
#   d'écouter (start_period de 120 s sur son healthcheck) et réclame ~2 Go de RAM.
#   Un conteneur clamav qui redémarre en boucle sans jamais devenir « healthy » est
#   presque toujours un manque de mémoire allouée à Docker.
# ESCROW_ANTIVIRUS_CONNECT_TIMEOUT_MS : défaut 2000. À relever seulement si le
#   poste est très chargé (le service est sur le réseau interne compose).
# ESCROW_ANTIVIRUS_READ_TIMEOUT_MS : défaut 30000. C'est l'attente de l'analyse
#   elle-même ; un fichier de 10 Mo est analysé en quelques centaines de ms.
ESCROW_ANTIVIRUS_CONNECT_TIMEOUT_MS=2000
ESCROW_ANTIVIRUS_READ_TIMEOUT_MS=30000

# Optionnel — création du compte ADMIN au premier démarrage (Story 1.1) :
# laisser vide = aucun ADMIN créé (les deux sont requis ensemble).
ESCROW_BOOTSTRAP_ADMIN_EMAIL=
ESCROW_BOOTSTRAP_ADMIN_PASSWORD=

# --- Reverse-proxy TLS (Story 1.4) ---
# Ports hôte de l'ingress unique (frontend). Le backend n'est plus publié.
# Accès local : https://localhost:8443 (certificat auto-signé généré au démarrage
# du conteneur => avertissement navigateur attendu en local). HTTP -> redirigé HTTPS.
# Défauts hors des collisions connues (nginx local 8080, postgres 5432).
INGRESS_HTTP_PORT=8080
INGRESS_HTTPS_PORT=8443
# En staging/prod : monter un vrai certificat sur /etc/nginx/certs (tls.crt/tls.key)
# via un volume, écrasant le certificat auto-signé de l'image.

# --- Surface d'API : CORS + documentation (Story 1.5, NFR-P4) ---
# Ces DEUX variables vont ensemble. Laissées VIDES (défaut), la stack reste en
# mode développement : CORS permissif, et les handlers Swagger/OpenAPI ACTIFS
# côté backend. NB : l'ingress nginx renvoie 404 sur /swagger-ui* et /v3/api-docs*
# (il ne proxifie que /api/) — Swagger n'est donc PAS joignable via https://localhost:8443
# dans la stack conteneurisée. Pour explorer l'API en dev, lancer le backend
# directement (mvn spring-boot:run) et ouvrir http://localhost:8080/swagger-ui.html.
#
# SPRING_PROFILES_ACTIVE=prod bascule le durcissement :
#   - documentation d'API fermée (spec OpenAPI + Swagger UI : 403/404, plus aucun
#     handler springdoc) ;
#   - CORS restreint à l'allowlist exacte ci-dessous.
# Le backend REFUSE alors de démarrer si ESCROW_CORS_ALLOWED_ORIGINS est absente,
# vide, contient '*' ou une entrée malformée (message nommant la variable).
#
# ESCROW_CORS_ALLOWED_ORIGINS : origines navigateur autorisées, séparées par des
# virgules. Chaque entrée est une origine ABSOLUE, comparée à l'identique :
#   scheme://hôte[:port]  —  ni chemin, ni '/' final, ni joker '*'.
#   ex. ESCROW_CORS_ALLOWED_ORIGINS=https://app.exemple.com,https://admin.exemple.com
# Inutile d'y lister le PWA servi par cet ingress : il appelle l'API en MÊME
# ORIGINE (/api/v1/...), et une requête same-origin n'est pas une requête CORS.
# N'y lister que les origines TIERCES (autre domaine, portail partenaire...).
SPRING_PROFILES_ACTIVE=
ESCROW_CORS_ALLOWED_ORIGINS=

# --- Transport e-mail local : collecteur Mailpit (Story 2.4, décision T0) ---
# AUCUN SECRET ICI : Mailpit n'authentifie pas et ne relaie rien vers l'extérieur.
#
# À quoi ça sert : sans transport, le code d'inscription (OTP) ne quitte jamais le
# backend et l'inscription est INFINISSABLE dans l'IHM. Mailpit capte le message ;
# le code se lit sur http://localhost:8025 — c'est la seule voie prévue, aucun
# endpoint de lecture d'OTP n'existe côté application et il ne doit jamais en exister.
#
# ESCROW_MAIL_TRANSPORT : `smtp` (défaut du compose) livre vers Mailpit ; `outbox`
#   revient au comportement d'avant — l'envoi est consigné, rien n'est livré.
#   Le défaut du CODE reste `outbox` : un déploiement muet ne livre rien.
# Ports : à ne changer qu'en cas de collision locale (cf. 8080/5432 déjà connus).
ESCROW_MAIL_TRANSPORT=smtp
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Observabilité : métriques, traces, tableau de bord (Story 11.4) ---
# La pile monte sur le POSTE DE DÉVELOPPEMENT (décision Q1 du 2026-08-11) : son
# déploiement en production est un écart nommé, routé vers la Story 11.3. Prometheus,
# Jaeger et Grafana ne publient QUE sur la boucle locale (127.0.0.1) — Prometheus et
# Jaeger ne s'authentifient pas du tout, et c'est ce cantonnement qui en tient lieu.
#
# ⚠ GRAFANA_ADMIN_PASSWORD n'a PAS de valeur par défaut dans le compose : sans elle,
#   la pile refuse de démarrer. C'est délibéré — l'image Grafana démarrerait sinon sur
#   `admin/admin`, et un mot de passe par défaut laissé en place ne se voit pas.
#   Générer comme les autres :  openssl rand -base64 48   (charset base64 uniquement,
#   $ " \ ` étant altérés par l'interpolation compose).
# Consultation : Grafana http://localhost:3000 · Prometheus http://localhost:9090
#   · Jaeger http://localhost:16686 · métriques du broker http://localhost:15692/metrics
GRAFANA_ADMIN_USER=escrow-admin
GRAFANA_ADMIN_PASSWORD=remplacez-moi
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
# Alertmanager (T5). Le canal d'alerte est un SMTP vers le Mailpit du compose : il
# prouve la chaîne SANS préempter le spike AR-P6 (« SMTP est un protocole, pas un
# fournisseur », précédent 2-4). Les alertes délivrées se lisent donc sur
# http://localhost:8025, au même endroit que les OTP.
ALERTMANAGER_PORT=9093
