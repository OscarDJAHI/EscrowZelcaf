{
  // Le code d'application : navigateur uniquement. `types: []` est hérité de
  // `@vue/tsconfig/tsconfig.dom.json` et n'est PAS rouvert ici — c'est ce qui
  // empêche un composant d'accéder aux types Node et de compiler un `process.env`
  // ou un `require` qui n'existeraient pas à l'exécution.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Même alias que `vite.config.ts` et `vitest.config.ts`. Les trois doivent
    // rester d'accord : le compilateur ne lit pas la configuration de Vite.
    "paths": { "@/*": ["./src/*"] }
  }
}
